{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Expo's base config leaves `types` unset, which auto-includes every @types package
    // it can find; naming them keeps the jest globals in the test files resolvable
    // without dragging in whatever else happens to be hoisted at the workspace root.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
