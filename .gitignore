# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Paths are intentionally un-anchored: this is a pnpm workspace, so node_modules /
# build output exist under apps/* and packages/* as well as at the root.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# build output
build
dist

# expo
.expo/
android/
ios/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
